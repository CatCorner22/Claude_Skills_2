# Never commit raw or real environment data — only sanitized, structural examples belong in git.
# Tailoring files that hold real client/bank/COA data use the .private/.local suffix and stay local.
*.private.md
*.private.*
**/references/*.local.*
**/references/your-environment.private.md

# Secrets
.env
.env.*
*.key
*.pem

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python tooling (skills may bundle scripts)
__pycache__/
*.pyc
.venv/
venv/

# Node / bundled JS tooling
node_modules
dist
*.local
tsconfig.tsbuildinfo

# Spreadsheet data files (never commit real workbooks)
*.xlsx
*.xlsm
*.xls

# Genomic data — the most sensitive class this library touches, and this repo is PUBLIC.
# Raw genotype and sequence files must NEVER be committed. Keep them outside the repo entirely
# where possible; if a file must sit beside the work, put it in genomes/ (ignored below) or give
# it a .private.* suffix. Only synthetic, structural fixtures belong in git.
genomes/
*.vcf
*.vcf.gz
*.vcf.bgz
*.vcf.gz.tbi
*.vcf.bgz.tbi
*.gvcf
*.gvcf.gz
*.bcf
*.bam
*.bai
*.cram
*.crai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bim
*.fam
*.23andme.txt
genome_*.txt
# The download is an ARCHIVE, and that is the form a user actually has on disk first:
# 23andMe and AncestryDNA both hand over a .zip. No .zip is tracked in this repo, so this is
# safe to blanket-ignore, and the archive is the file most likely to be dropped in by mistake.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
genome.txt
*_Full_*.txt

# claude plugin eval writes its run results beside the cases
plugins/*/evals/results/
